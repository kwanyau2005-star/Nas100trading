# Example environment variables
DATA_SOURCE=demo
MINIDOC_TOKEN=
MINIDOC_WS_URL=
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
NEWS_WEBHOOK_SECRET=change_this
USE_WS=true

# itick futures API settings
ITICK_BASE_URL=https://itick.org
ITICK_KLINES_ENDPOINT=/api/v1/futures/klines
ITICK_API_KEY=
ITICK_API_SECRET=
ITICK_ACCOUNT=
ITICK_SYMBOL=NAS100
ITICK_INTERVAL=1m
ITICK_LIMIT=500
ITICK_TIMEOUT_SECONDS=15

# Tradovate API settings
TRADOVATE_BASE_URL=https://demo-api.tradovate.com
TRADOVATE_AUTH_ENDPOINT=/v1/auth/accesstokenrequest
TRADOVATE_CHART_ENDPOINT=/md/getchart
TRADOVATE_USERNAME=
TRADOVATE_PASSWORD=
TRADOVATE_APP_ID=
TRADOVATE_APP_VERSION=1.0
TRADOVATE_CID=
TRADOVATE_SECRET=
TRADOVATE_DEVICE_ID=
TRADOVATE_ACCESS_TOKEN=
TRADOVATE_SYMBOL=MNQ
TRADOVATE_INTERVAL=1m
TRADOVATE_LIMIT=500
TRADOVATE_TIMEOUT_SECONDS=15
